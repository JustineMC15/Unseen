<file path="src/autoload/game_state.gd">
extends Node
## Autoload as "GameState". Owns the high-level state of the run.
## Other systems listen to state_changed instead of polling.

enum State { MENU, PLAYING, PAUSED, GAME_OVER, WIN }

signal state_changed(previous: State, new_state: State)

## Defaults to PLAYING so any scene can be run directly with F6 for testing.
## The main menu scene should call go_to_menu() / set MENU when it loads.
var current: State = State.PLAYING

func _ready() -> void:
	# Must keep running while the tree is paused, or it could never unpause it.
	process_mode = Node.PROCESS_MODE_ALWAYS

func _unhandled_input(event: InputEvent) -> void:
	if event.is_action_pressed("ui_cancel"):
		if current == State.PLAYING:
			pause_game()
		elif current == State.PAUSED:
			resume_game()

func is_playing() -> bool:
	return current == State.PLAYING

## Pass a scene path to load it first (e.g. from the main menu's Start button).
func start_game(scene_path: String = "") -> void:
	_set_state(State.PLAYING)
	if scene_path != "":
		get_tree().change_scene_to_file(scene_path)

func pause_game() -> void:
	if current == State.PLAYING:
		_set_state(State.PAUSED)

func resume_game() -> void:
	if current == State.PAUSED:
		_set_state(State.PLAYING)

func game_over() -> void:
	if current == State.PLAYING:
		_set_state(State.GAME_OVER)

func win() -> void:
	if current == State.PLAYING:
		_set_state(State.WIN)

func restart() -> void:
	_set_state(State.PLAYING)
	get_tree().reload_current_scene()

func go_to_menu(scene_path: String) -> void:
	_set_state(State.MENU)
	get_tree().change_scene_to_file(scene_path)

func _set_state(new_state: State) -> void:
	if new_state == current:
		return
	var previous := current
	current = new_state
	get_tree().paused = new_state in [State.PAUSED, State.GAME_OVER, State.WIN]
	Input.mouse_mode = (
		Input.MOUSE_MODE_CAPTURED if new_state == State.PLAYING
		else Input.MOUSE_MODE_VISIBLE
	)
	state_changed.emit(previous, new_state)

func enter_menu() -> void:
	_set_state(State.MENU)
</file>

<file path="src/debug/debug_hud.gd">
## TEMPORARY. Shows what the Interactor and Inventory report, so you can test
## without Randy's UI. Delete this once his HUD is in.
## Add a CanvasLayer node to the test world and attach this script.
extends CanvasLayer

var _prompt: Label
var _feedback: Label
var _items: Label
var _inventory: Inventory

func _ready() -> void:
	var box := VBoxContainer.new()
	box.set_anchors_preset(Control.PRESET_BOTTOM_WIDE)
	box.offset_top = -150.0
	box.offset_bottom = -20.0
	add_child(box)
	_feedback = _make_label(box)
	_prompt = _make_label(box)
	_items = _make_label(box)

	# Wait one frame so the Player has joined the "player" group.
	await get_tree().process_frame
	var player := get_tree().get_first_node_in_group("player")
	if player == null:
		push_warning("DebugHUD: no node in group 'player'.")
		return
	var interactor := player.get_node_or_null("Interactor") as Interactor
	_inventory = player.get_node_or_null("Inventory") as Inventory
	if interactor == null or _inventory == null:
		push_warning("DebugHUD: Player needs 'Interactor' and 'Inventory' child nodes.")
		return
	interactor.prompt_changed.connect(_on_prompt_changed)
	interactor.feedback.connect(_on_feedback)
	_inventory.item_added.connect(func(_item, _slot): _refresh_items())
	_inventory.item_removed.connect(func(_item, _slot): _refresh_items())
	_inventory.selection_changed.connect(func(_slot): _refresh_items())
	_refresh_items()

func _make_label(parent: Control) -> Label:
	var label := Label.new()
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	parent.add_child(label)
	return label

func _on_prompt_changed(text: String) -> void:
	_prompt.text = ("[E] " + text) if text != "" else ""

func _on_feedback(text: String) -> void:
	_feedback.text = text
	get_tree().create_timer(2.0).timeout.connect(
		func(): if _feedback.text == text: _feedback.text = ""
	)

func _refresh_items() -> void:
	var parts: Array[String] = []
	var slots := _inventory.get_slots()
	for i in slots.size():
		if slots[i] != null:
			var marker := ">" if i == _inventory.selected_slot else ""
			# The 10th slot is the 0 key.
			parts.append("%s[%d] %s" % [marker, (i + 1) % 10, slots[i].display_name])
	_items.text = "Items: " + ("empty" if parts.is_empty() else "  ".join(parts))

func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventKey and event.pressed and not event.echo:
		if event.keycode == KEY_F5:
			var system := get_tree().get_first_node_in_group("save_system") as SaveSystem
			if system:
				print("Saved slot 1: ", system.save_to_slot(0))
		elif event.keycode == KEY_F9:
			var path := SaveStore.begin_load(0)
			if path != "":
				GameState.start_game(path)

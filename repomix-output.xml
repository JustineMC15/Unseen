<file path="src/player/footstep_noise.gd">
class_name FootstepNoise
extends Node

# Based on velocity
@export var walk_loudness: float = 0.15
@export var sprint_loudness: float = 0.4
# Meters walked per step noise.
@export var walk_stride: float = 2.0
@export var sprint_stride: float = 2.5
@export var sprint_action: StringName = &"sprint"

var _body: CharacterBody3D
var _location: LocationTracker
var _distance: float = 0.0

func _ready() -> void:
	_body = get_parent() as CharacterBody3D
	_location = LocationTracker.find_on(_body)

func _physics_process(delta: float) -> void:
	if _body == null or not _body.is_on_floor():
		return
	var speed := Vector2(_body.velocity.x, _body.velocity.z).length()
	if speed < 0.5:
		return
	var sprinting := Input.is_action_pressed(sprint_action)
	_distance += speed * delta
	if _distance < (sprint_stride if sprinting else walk_stride):
		return
	_distance = 0.0
	NoiseManager.emit_noise(
		&"footstep_sprint" if sprinting else &"footstep_walk",
		sprint_loudness if sprinting else walk_loudness,
		_location.room_id if _location else &"",
		_location.floor_id if _location else 0,
		_body.global_position
	)
</file>

<file path="src/player/wake_up_sequence.gd">
class_name WakeUpSequence
extends Node

signal started        # screen is black; start breathing / ambience here
signal eyes_opened    # the first flutter begins
signal finished

const SHADER: Shader = preload("res://src/ui/effects/eyelid_open.gdshader")

@export var enabled: bool = true
## Seconds of black before the eyes start to open.
@export var start_delay: float = 1.0
## Negative looks down.
@export var start_pitch_deg: float = -65.0
## Metres the head starts below its normal height.
@export var head_drop: float = 0.5
## Seconds for the camera to rise to eye level.
@export var camera_time: float = 4.2

var _player: Player
var _layer: CanvasLayer
var _material: ShaderMaterial
var _tween: Tween

func _ready() -> void:
	if not enabled:
		return
	_player = get_parent() as Player
	if _player == null:
		push_warning("WakeUpSequence: must be a child of the Player.")
		return
	# Black immediately, so the scene never flashes before the animation starts.
	_build_overlay()
	# The Player's @onready vars (head, camera) are not set until its own _ready has run.
	await get_tree().process_frame
	_play()

func _build_overlay() -> void:
	_layer = CanvasLayer.new()
	_layer.layer = 100
	add_child(_layer)
	var rect := ColorRect.new()
	rect.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_material = ShaderMaterial.new()
	_material.shader = SHADER
	_material.set_shader_parameter("open", 0.0)
	_material.set_shader_parameter("blur", 1.0)
	rect.material = _material
	_layer.add_child(rect)
	rect.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)

func _play() -> void:
	var head := _player.head
	var rest_y := head.position.y
	head.rotation.x = deg_to_rad(start_pitch_deg)
	head.position.y = rest_y - head_drop
	_player.freeze_controls()
	started.emit()

	# Eyelids: flutter open, blink, open more, blink, open fully.
	_tween = create_tween()
	_tween.tween_interval(start_delay)
	_tween.tween_callback(eyes_opened.emit)
	_lid(0.30, 0.9, 0.9)
	_lid(0.04, 0.35, 1.0)
	_lid(0.65, 0.8, 0.55)
	_lid(0.12, 0.3, 0.7)
	_lid(1.0, 1.4, 0.0)

	# Camera: starts a moment after the eyes begin to open. Finishing it ends the sequence.
	var delay := start_delay + 0.3
	var cam := create_tween().set_parallel(true)
	cam.tween_property(head, "rotation:x", 0.0, camera_time) \
		.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT).set_delay(delay)
	cam.tween_property(head, "position:y", rest_y, camera_time) \
		.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT).set_delay(delay)
	cam.finished.connect(_finish)

func _lid(open_to: float, time: float, blur_to: float) -> void:
	_tween.tween_property(_material, "shader_parameter/open", open_to, time) \
		.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	_tween.parallel().tween_property(_material, "shader_parameter/blur", blur_to, time)

func _finish() -> void:
	if _tween:
		_tween.kill()
	_layer.queue_free()
	_player.unlock_controls()
	finished.emit()
</file>

<file path="src/save/save_item_controller.gd">
class_name SaveItemController
extends Node

signal picker_requested
signal saved(slot: int)
signal cancelled

@export var inventory: Inventory
@export var save_system: SaveSystem
# Optional. Used only to show "Game saved." through the usual feedback message.
@export var interactor: Interactor
@export var save_action: StringName = &"save_game"
# If true, each rosary is used up by one save.
@export var consume_item: bool = true

var _pending_inventory_slot: int = -1

func _ready() -> void:
	add_to_group("save_item_controller")
	if inventory == null or save_system == null:
		push_warning("SaveItemController: assign 'inventory' and 'save_system' in the Inspector.")
		return
	inventory.item_used.connect(_on_item_used)

func is_picking() -> bool:
	return _pending_inventory_slot != -1

func _on_item_used(item: ItemData, inventory_slot: int) -> void:
	if item.use_action != save_action or is_picking():
		return
	_pending_inventory_slot = inventory_slot
	picker_requested.emit()

## Called by the UI with the slot the player picked (0-3). Returns true if saved.
func confirm(save_slot: int) -> bool:
	if not is_picking():
		return false
	# The rosary is removed BEFORE saving, so the save file does not contain it.
	# Otherwise loading that save would hand the rosary back for free.
	var used: ItemData = null
	if consume_item:
		used = inventory.remove_item(_pending_inventory_slot)
	var ok := save_system.save_to_slot(save_slot)
	if not ok and used != null:
		inventory.add_item(used)
	_pending_inventory_slot = -1
	if ok:
		saved.emit(save_slot)
		if interactor != null:
			interactor.show_feedback("Game saved.")
	return ok

# Called by the UI when the player backs out of the slot picker. The rosary is kept.
func cancel() -> void:
	if not is_picking():
		return
	_pending_inventory_slot = -1
	cancelled.emit()
</file>

<file path="src/save/save_store.gd">
class_name SaveStore
extends RefCounted

const SLOT_COUNT: int = 4
const SAVE_DIR: String = "user://saves"
const SAVE_VERSION: int = 1

static var _pending: Dictionary = {}

static func is_valid_slot(slot: int) -> bool:
	return slot >= 0 and slot < SLOT_COUNT

static func slot_exists(slot: int) -> bool:
	return is_valid_slot(slot) and FileAccess.file_exists(_path(slot))

static func get_slot_info(slot: int) -> Dictionary:
	var data := read_slot(slot)
	if data.is_empty():
		return {"exists": false}
	var saved_at: int = data.get("saved_at", 0)
	var bias_seconds: int = Time.get_time_zone_from_system().bias * 60
	return {
		"exists": true,
		"saved_at": saved_at,
		"saved_at_text": Time.get_datetime_string_from_unix_time(saved_at + bias_seconds, true),
		"scene": data.get("scene", ""),
		"summary": data.get("summary", {}),
	}

# Overwrites the slot. Adds the version and the save time itself.
static func write_slot(slot: int, data: Dictionary) -> bool:
	if not is_valid_slot(slot):
		push_warning("SaveStore: slot %d is not valid (0-%d)." % [slot, SLOT_COUNT - 1])
		return false
	DirAccess.make_dir_recursive_absolute(SAVE_DIR)
	var file := FileAccess.open(_path(slot), FileAccess.WRITE)
	if file == null:
		push_error("SaveStore: cannot write slot %d (error %d)." % [slot, FileAccess.get_open_error()])
		return false
	var stamped := data.duplicate()
	stamped["version"] = SAVE_VERSION
	stamped["saved_at"] = int(Time.get_unix_time_from_system())
	file.store_string(var_to_str(stamped))
	file.close()
	return true

# {} if the slot is empty, unreadable or from an incompatible version.
static func read_slot(slot: int) -> Dictionary:
	if not slot_exists(slot):
		return {}
	var parsed: Variant = str_to_var(FileAccess.get_file_as_string(_path(slot)))
	if typeof(parsed) != TYPE_DICTIONARY:
		return {}
	if parsed.get("version", 0) != SAVE_VERSION:
		push_warning("SaveStore: slot %d has an incompatible save version." % slot)
		return {}
	return parsed

static func delete_slot(slot: int) -> bool:
	if not slot_exists(slot):
		return false
	DirAccess.remove_absolute(_path(slot))
	return true

# Stores the slot's data for the next level and returns the scene path to open.
# Returns "" (and warns) if the slot is empty or its scene is missing.
static func begin_load(slot: int) -> String:
	var data := read_slot(slot)
	if data.is_empty():
		push_warning("SaveStore: slot %d is empty or unreadable." % slot)
		return ""
	var scene_path: String = data.get("scene", "")
	if not ResourceLoader.exists(scene_path):
		push_warning("SaveStore: saved scene not found: '%s'" % scene_path)
		return ""
	_pending = data
	return scene_path

static func has_pending() -> bool:
	return not _pending.is_empty()

# Hands over the waiting data once and clears it.
static func take_pending() -> Dictionary:
	var data := _pending
	_pending = {}
	return data

static func _path(slot: int) -> String:
	return "%s/slot_%d.save" % [SAVE_DIR, slot + 1]
</file>

<file path="src/save/save_system.gd">
class_name SaveSystem
extends Node

signal slot_saved(slot: int)
signal loaded

const GROUP: StringName = &"saveable"

func _ready() -> void:
	add_to_group("save_system")
	if SaveStore.has_pending():
		_restore_pending()

# Saves the running level into the slot (0-3), overwriting it.
func save_to_slot(slot: int) -> bool:
	var scene := get_tree().current_scene
	if scene == null:
		return false

	var objects: Dictionary = {}
	var summary: Dictionary = {}
	for node in get_tree().get_nodes_in_group(GROUP):
		var key := str(scene.get_path_to(node))
		if node.has_method("capture_state"):
			objects[key] = node.capture_state()
		if node.has_method("get_save_summary"):
			summary.merge(node.get_save_summary(), true)

	var data: Dictionary = {
		"scene": scene.scene_file_path,
		"summary": summary,
		"objects": objects,
	}
	if not SaveStore.write_slot(slot, data):
		return false
	slot_saved.emit(slot)
	return true

func _restore_pending() -> void:
	# Wait a frame so every other node in the level has finished its _ready().
	await get_tree().process_frame
	var data := SaveStore.take_pending()
	var scene := get_tree().current_scene
	if scene == null or data.is_empty():
		return
	var saved: Dictionary = data.get("objects", {})
	for node in get_tree().get_nodes_in_group(GROUP):
		var key := str(scene.get_path_to(node))
		if saved.has(key):
			if node.has_method("restore_state"):
				node.restore_state(saved[key])
		elif node.has_method("on_missing_from_save"):
			node.on_missing_from_save()
	loaded.emit()
</file>

<file path="src/ui/game_menu/interaction_hud.gd">
## Put this on a Control inside the HUD CanvasLayer. Replaces the prompt and feedback
## part of debug_hud.gd. It only listens to the Interactor's signals; the Interactor
## doesn't know the HUD exists.
## Assign the two Labels in the Inspector. "interactor" is optional: if empty, it is
## found on the node in group "player".
class_name InteractionHud
extends Control

@export var interactor: Interactor
## Shows the prompt, e.g. "[E] Open". Hidden whenever the prompt is empty.
@export var prompt_label: Label
## One-off messages like "It's locked." or "Inventory full."
@export var feedback_label: Label
## %s becomes the prompt text from the Interactor.
@export var prompt_format: String = "[E] %s"
@export var feedback_time: float = 2.0

var _feedback_tween: Tween

func _ready() -> void:
	if prompt_label:
		prompt_label.visible = false
	if feedback_label:
		feedback_label.visible = false
	if interactor == null:
		# Wait a frame so the Player has joined the "player" group.
		await get_tree().process_frame
		interactor = _find_interactor()
	if interactor == null:
		push_warning("InteractionHud: no Interactor assigned and none found under the player.")
		return
	interactor.prompt_changed.connect(_on_prompt_changed)
	interactor.feedback.connect(_on_feedback)

func _find_interactor() -> Interactor:
	var player := get_tree().get_first_node_in_group("player")
	if player == null:
		return null
	for child in player.get_children():
		if child is Interactor:
			return child as Interactor
	return null

func _on_prompt_changed(text: String) -> void:
	if prompt_label == null:
		return
	prompt_label.visible = text != ""
	prompt_label.text = prompt_format % text if text != "" else ""

func _on_feedback(text: String) -> void:
	if feedback_label == null:
		return
	feedback_label.text = text
	feedback_label.visible = true
	if _feedback_tween:
		_feedback_tween.kill()
	_feedback_tween = create_tween()
	_feedback_tween.tween_interval(feedback_time)
	_feedback_tween.tween_callback(func() -> void: feedback_label.visible = false)
</file>

<file path="src/ui/game_menu/inventory_bar.gd">
## Shows the Inventory's 10 slots on Randy's layout. It only listens to Inventory signals.
## Layout rule: "slots_container" has one child Control per slot, in slot order (slot 1 first).
## Inside each slot, the first TextureRect shows the item icon and the first Label shows
## the item name. Both are optional, and a slot with extra decoration (frame, background)
## is fine. Put the slot NUMBER label outside the slot, or it would be overwritten.
## "inventory" is optional: if empty, it is found on the node in group "player".
class_name InventoryBar
extends Control

@export var inventory: Inventory
@export var slots_container: Control
@export var normal_modulate: Color = Color.WHITE
@export var empty_modulate: Color = Color(1.0, 1.0, 1.0, 0.4)
@export var selected_modulate: Color = Color(1.0, 0.85, 0.3)
## True: the bar only shows while the inventory is open (Tab). False: always visible.
@export var show_only_when_open: bool = false

var _slots: Array[Control] = []
var _icons: Array[TextureRect] = []
var _names: Array[Label] = []

func _ready() -> void:
	if slots_container == null:
		push_warning("InventoryBar: assign 'slots_container' in the inspector.")
		return
	for child in slots_container.get_children():
		var slot := child as Control
		if slot == null:
			continue
		_slots.append(slot)
		_icons.append(_find_icon(slot))
		_names.append(_find_name(slot))
	if inventory == null:
		# Wait a frame so the Player has joined the "player" group.
		await get_tree().process_frame
		inventory = _find_inventory()
	if inventory == null:
		push_warning("InventoryBar: no Inventory assigned and none found under the player.")
		return
	inventory.item_added.connect(_on_slot_changed)
	inventory.item_removed.connect(_on_slot_changed)
	inventory.selection_changed.connect(_on_selection_changed)
	if show_only_when_open:
		visible = inventory.is_ui_open
		inventory.ui_toggled.connect(_on_ui_toggled)
	_refresh()

func _find_inventory() -> Inventory:
	var player := get_tree().get_first_node_in_group("player")
	if player == null:
		return null
	for child in player.get_children():
		if child is Inventory:
			return child as Inventory
	return null

func _find_icon(node: Node) -> TextureRect:
	for child in node.get_children():
		if child is TextureRect:
			return child as TextureRect
		var deeper := _find_icon(child)
		if deeper != null:
			return deeper
	return null

func _find_name(node: Node) -> Label:
	for child in node.get_children():
		if child is Label:
			return child as Label
		var deeper := _find_name(child)
		if deeper != null:
			return deeper
	return null

func _on_slot_changed(_item: ItemData, _slot: int) -> void:
	_refresh()

func _on_selection_changed(_slot: int) -> void:
	_refresh()

func _on_ui_toggled(is_open: bool) -> void:
	visible = is_open

func _refresh() -> void:
	var items := inventory.get_slots()
	for i in mini(_slots.size(), items.size()):
		var item := items[i]
		if _icons[i]:
			_icons[i].texture = item.icon if item != null else null
		if _names[i]:
			_names[i].text = item.display_name if item != null else ""
		if i == inventory.selected_slot:
			_slots[i].modulate = selected_modulate
		else:
			_slots[i].modulate = normal_modulate if item != null else empty_modulate
</file>

<file path="src/ui/game_menu/state_screen.gd">
## Put this on the ROOT Control of a pause, game over or win screen (full rect, inside a CanvasLayer).
## One script for all three: pick which GameState state shows it in "show_on_state".
## It hides itself otherwise and listens to GameState.state_changed, so nothing else
## needs to know it exists. Buttons are optional Inspector slots; leave one empty if the
## screen doesn't have it (a win screen has no Resume, a pause screen has no Restart).
class_name StateScreen
extends Control

signal screen_shown
signal screen_hidden

@export_enum("PAUSED", "GAME_OVER", "WIN") var show_on_state: String = "GAME_OVER"
## Wait this long before appearing. 0.8 on the game over screen lets the camera shake play first.
@export var show_delay: float = 0.0
@export var fade_in_time: float = 0.4
@export var resume_button: BaseButton
@export var restart_button: BaseButton
@export var menu_button: BaseButton
## Scene the menu button goes to (the main menu).
@export_file("*.tscn") var menu_scene: String = ""

var _token: int = 0

func _ready() -> void:
	# Must keep running while the tree is paused, or the buttons would never respond.
	process_mode = Node.PROCESS_MODE_ALWAYS
	visible = false
	if resume_button:
		resume_button.pressed.connect(GameState.resume_game)
	if restart_button:
		restart_button.pressed.connect(GameState.restart)
	if menu_button:
		# Same rule as the main menu: no valid scene means the button is disabled.
		if menu_scene == "" or not ResourceLoader.exists(menu_scene):
			menu_button.disabled = true
		else:
			menu_button.pressed.connect(_on_menu_pressed)
	GameState.state_changed.connect(_on_game_state_changed)
	_apply_state(GameState.current)

func _on_game_state_changed(_previous: GameState.State, new_state: GameState.State) -> void:
	_apply_state(new_state)

func _apply_state(state: GameState.State) -> void:
	if GameState.State.keys()[state] == show_on_state:
		_show_screen()
	else:
		_hide_screen()

func _show_screen() -> void:
	# The token cancels a pending delayed show if the state changes again first.
	_token += 1
	var my_token := _token
	if show_delay > 0.0:
		await get_tree().create_timer(show_delay).timeout
		if my_token != _token:
			return
	visible = true
	if fade_in_time > 0.0:
		modulate.a = 0.0
		create_tween().tween_property(self, "modulate:a", 1.0, fade_in_time)
	else:
		modulate.a = 1.0
	for button in [resume_button, restart_button, menu_button]:
		if button != null and not button.disabled:
			button.grab_focus()
			break
	screen_shown.emit()

func _hide_screen() -> void:
	_token += 1
	if visible:
		visible = false
		screen_hidden.emit()

func _on_menu_pressed() -> void:
	GameState.go_to_menu(menu_scene)
</file>

<file path="src/ui/main_menu/horror_button.gd">
extends Button
	
@export var normal_scale := Vector2(1.0, 1.0)
@export var hover_scale := Vector2(1.05, 1.05)

var scale_tween: Tween
var effect_tween: Tween
var static_tween: Tween

var normal_style: StyleBoxFlat
var hover_style: StyleBoxFlat


func _ready() -> void:
	await get_tree().process_frame

	# Keep scaling centered
	pivot_offset = size / 2.0

	# --------------------------------------------------
	# NORMAL BUTTON STYLE
	# --------------------------------------------------

	normal_style = StyleBoxFlat.new()
	normal_style.bg_color = Color(0, 0, 0, 0) # completely transparent
	normal_style.border_width_left = 0
	normal_style.border_width_right = 0
	normal_style.border_width_top = 0
	normal_style.border_width_bottom = 0

	# --------------------------------------------------
	# HOVER BUTTON STYLE
	# --------------------------------------------------

	hover_style = StyleBoxFlat.new()

	# White scary/glowing box
	hover_style.bg_color = Color(1, 1, 1, 0.10)

	# Thin white border
	hover_style.border_width_left = 2
	hover_style.border_width_right = 2
	hover_style.border_width_top = 2
	hover_style.border_width_bottom = 2

	hover_style.border_color = Color(1, 1, 1, 0.75)

	# Slight rounded corners
	hover_style.corner_radius_top_left = 2
	hover_style.corner_radius_top_right = 2
	hover_style.corner_radius_bottom_left = 2
	hover_style.corner_radius_bottom_right = 2

	# Small internal margins
	hover_style.content_margin_left = 15
	hover_style.content_margin_right = 15
	hover_style.content_margin_top = 5
	hover_style.content_margin_bottom = 5

	# --------------------------------------------------
	# APPLY NORMAL STYLE
	# --------------------------------------------------

	add_theme_stylebox_override("normal", normal_style)
	add_theme_stylebox_override("hover", hover_style)
	add_theme_stylebox_override("focus", hover_style)
	add_theme_stylebox_override("pressed", hover_style)

	# --------------------------------------------------
	# HORROR FONT GLOW
	# --------------------------------------------------

	add_theme_color_override(
		"font_color",
		Color(1, 1, 1, 1)
	)

	add_theme_color_override(
		"font_hover_color",
		Color(1, 0.15, 0.15, 1)
	)

	add_theme_color_override(
		"font_focus_color",
		Color(1, 0.15, 0.15, 1)
	)

	add_theme_color_override(
		"font_pressed_color",
		Color(1, 1, 1, 1)
	)

	# Horror/static outline
	add_theme_color_override(
		"font_outline_color",
		Color(1, 1, 1, 0.35)
	)

	add_theme_constant_override(
		"outline_size",
		3
	)

	# Small shadow/glow
	add_theme_color_override(
		"font_shadow_color",
		Color(1, 1, 1, 0.25)
	)

	add_theme_constant_override(
		"shadow_offset_x",
		0
	)

	add_theme_constant_override(
		"shadow_offset_y",
		0
	)

	# --------------------------------------------------
	# SIGNALS
	# --------------------------------------------------

	mouse_entered.connect(_on_mouse_entered)
	mouse_exited.connect(_on_mouse_exited)

	focus_entered.connect(_on_focus_entered)
	focus_exited.connect(_on_focus_exited)

func _on_mouse_entered() -> void:
	_start_horror_effect()


func _on_mouse_exited() -> void:
	_stop_horror_effect()


func _on_focus_entered() -> void:
	_start_horror_effect()


func _on_focus_exited() -> void:
	_stop_horror_effect()


func _start_horror_effect() -> void:

	# Stop old tweens
	if scale_tween:
		scale_tween.kill()

	if effect_tween:
		effect_tween.kill()

	if static_tween:
		static_tween.kill()

	# --------------------------------------------------
	# SCALE
	# --------------------------------------------------

	scale_tween = create_tween()
	scale_tween.set_trans(Tween.TRANS_SINE)
	scale_tween.set_ease(Tween.EASE_OUT)

	scale_tween.tween_property(
		self,
		"scale",
		hover_scale,
		0.12
	)

	# --------------------------------------------------
	# STATIC / FLICKER
	# --------------------------------------------------

	effect_tween = create_tween()
	effect_tween.set_loops()

	effect_tween.tween_property(
		self,
		"modulate:a",
		0.82,
		0.045
	)

	effect_tween.tween_property(
		self,
		"modulate:a",
		1.0,
		0.055
	)

	effect_tween.tween_property(
		self,
		"modulate:a",
		0.90,
		0.035
	)

	effect_tween.tween_property(
		self,
		"modulate:a",
		1.0,
		0.10
	)

	# --------------------------------------------------
	# TINY HORROR GLITCH
	# --------------------------------------------------

	static_tween = create_tween()
	static_tween.set_loops()

	static_tween.tween_property(
		self,
		"rotation",
		deg_to_rad(0.4),
		0.04
	)

	static_tween.tween_property(
		self,
		"rotation",
		deg_to_rad(-0.4),
		0.04
	)

	static_tween.tween_property(
		self,
		"rotation",
		0.0,
		0.06
	)


func _stop_horror_effect() -> void:

	if scale_tween:
		scale_tween.kill()

	if effect_tween:
		effect_tween.kill()

	if static_tween:
		static_tween.kill()

	scale_tween = create_tween()

	scale_tween.set_trans(Tween.TRANS_SINE)
	scale_tween.set_ease(Tween.EASE_OUT)

	scale_tween.tween_property(
		self,
		"scale",
		normal_scale,
		0.12
	)

	modulate.a = 1.0
	rotation = 0.0
</file>


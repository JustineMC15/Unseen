<file path="src/entity/entity_perception.gd">
class_name EntityPerception
extends Node

@export var eyes: Node3D
@export var player: Node3D
@export var vision_range: float = 15.0
@export var vision_half_angle_deg: float = 40.0
@export var player_group: String = "player"
## Heights, relative to the player's origin, that the entity tries to see.
## Head, chest, legs. Seeing any one of them counts as seeing the player.
@export var sight_point_offsets: Array[float] = [0.8, 0.2, -0.5]

func _ready() -> void:
	if player == null:
		player = get_tree().get_first_node_in_group(player_group)

func can_see_player() -> bool:
	if player == null or eyes == null:
		return false

	if _player_is_hidden():
		return false

	var to_player := player.global_position - eyes.global_position
	if to_player.length() > vision_range:
		return false

	# Sideways angle only, so height differences on ramps don't shrink the cone.
	var forward := -eyes.global_transform.basis.z
	var flat_forward := Vector3(forward.x, 0.0, forward.z).normalized()
	var flat_to := Vector3(to_player.x, 0.0, to_player.z)
	if flat_to.length() > 0.01:
		var angle := rad_to_deg(flat_forward.angle_to(flat_to.normalized()))
		if angle > vision_half_angle_deg:
			return false

	return _has_line_of_sight()

func _has_line_of_sight() -> bool:
	var space_state := eyes.get_world_3d().direct_space_state
	for y_offset in sight_point_offsets:
		var query := PhysicsRayQueryParameters3D.create(
			eyes.global_position,
			player.global_position + Vector3.UP * y_offset
		)
		query.exclude = [eyes.get_parent()]
		var result := space_state.intersect_ray(query)
		if result.is_empty() or result.collider == player:
			return true
	return false

func _player_is_hidden() -> bool:
	return player.has_method("is_hidden") and player.is_hidden()
</file>

<file path="src/player/concealment.gd">
class_name Concealment
extends Node

signal concealment_broken

## Optional. If empty, it finds the AIEntity on its own.
@export var entity: AIEntity
## Staring at the entity this long (seconds) sends it to Detect, toward the hiding spot.
@export var suspect_time: float = 1.0
## Staring this long breaks cover and sends it to Chase. Keep it higher than suspect_time.
@export var reveal_time: float = 3.0

var is_hidden: bool = false
## Where the current hiding spot is. Set by HidingSpot / Locker.
var hiding_position: Vector3 = Vector3.ZERO

var _stare_timer: float = 0.0
var _suspected: bool = false

## Called by HidingSpot / Locker BEFORE the player is moved, so the entity's
## vision check still sees where the player was standing when they went in.
func enter_hiding_spot(spot_position: Vector3) -> void:
	hiding_position = spot_position
	_stare_timer = 0.0
	_suspected = false
	if _find_entity() and entity.perception.can_see_player():
		# Seen going in: no cover, and the entity commits to a chase toward the spot.
		# Transition first: Chase.enter() resets last_known_player_position to where
		# the player stands right now, so the spot has to be written after it.
		is_hidden = false
		entity.state_machine.force_transition("Chase")
		entity.last_known_player_position = spot_position
		return
	is_hidden = true

func exit_hiding_spot() -> void:
	is_hidden = false
	_stare_timer = 0.0
	_suspected = false

func _physics_process(delta: float) -> void:
	if not is_hidden or not _find_entity():
		return
	if GazeSystem.is_watched(entity):
		_stare_timer += delta
		if not _suspected and _stare_timer >= suspect_time:
			_suspected = true
			entity.last_known_player_position = hiding_position
			# A chasing entity already heads for last_known_player_position; don't downgrade it.
			if entity.state_machine.current_state_name != "Chase":
				entity.state_machine.force_transition("Detect")
		if _stare_timer >= reveal_time:
			_break_concealment()
	else:
		_stare_timer = max(_stare_timer - delta, 0.0)
		if _stare_timer == 0.0:
			_suspected = false

func _break_concealment() -> void:
	is_hidden = false
	_stare_timer = 0.0
	_suspected = false
	concealment_broken.emit()
	entity.state_machine.force_transition("Chase")

func _find_entity() -> bool:
	if entity == null:
		entity = get_tree().get_first_node_in_group("gaze_watchable") as AIEntity
	return entity != null
</file>

<file path="src/player/inventory.gd">
## Fixed 10 slots, one item per slot, no dropping.
## Only data and signals here; Randy's UI just listens and calls select_slot().
class_name Inventory
extends Node

signal item_added(item: ItemData, slot: int)
signal item_removed(item: ItemData, slot: int)
signal selection_changed(slot: int)
signal ui_toggled(is_open: bool)
signal item_used(item: ItemData, slot: int)

const MAX_SLOTS: int = 10

## -1 means nothing selected.
var selected_slot: int = -1

var _slots: Array[ItemData] = []
var is_ui_open: bool = false

func _ready() -> void:
	add_to_group("saveable")

func capture_state() -> Dictionary:
	var paths: Array = []
	for item in _slots:
		paths.append(item.resource_path if item != null else "")
	return {"slots": paths, "selected": selected_slot}

func restore_state(state: Dictionary) -> void:
	for i in MAX_SLOTS:
		remove_item(i)
	var paths: Array = state.get("slots", [])
	for i in mini(paths.size(), MAX_SLOTS):
		var path: String = paths[i]
		if path == "" or not ResourceLoader.exists(path):
			continue
		var item := load(path) as ItemData
		if item == null:
			continue
		_slots[i] = item
		item_added.emit(item, i)
	select_slot(state.get("selected", -1))

func _init() -> void:
	_slots.resize(MAX_SLOTS)

## Returns false if every slot is taken.
func add_item(item: ItemData) -> bool:
	var slot := _slots.find(null)
	if slot == -1:
		return false
	_slots[slot] = item
	item_added.emit(item, slot)
	return true

## Used items are removed this way. Returns the removed item (null if the slot was empty).
func remove_item(slot: int) -> ItemData:
	if slot < 0 or slot >= MAX_SLOTS or _slots[slot] == null:
		return null
	var item := _slots[slot]
	_slots[slot] = null
	item_removed.emit(item, slot)
	return item

func has_item(id: StringName) -> bool:
	for item in _slots:
		if item != null and item.id == id:
			return true
	return false

func is_full() -> bool:
	return not _slots.has(null)

func get_item(slot: int) -> ItemData:
	if slot < 0 or slot >= MAX_SLOTS:
		return null
	return _slots[slot]

## Always MAX_SLOTS long; empty slots are null.
func get_slots() -> Array[ItemData]:
	return _slots.duplicate()

func select_slot(slot: int) -> void:
	if slot < -1 or slot >= MAX_SLOTS or slot == selected_slot:
		return
	selected_slot = slot
	selection_changed.emit(slot)

func get_selected_item() -> ItemData:
	return get_item(selected_slot)

## Pressing the selected slot's key again deselects it.
func toggle_slot(slot: int) -> void:
	select_slot(-1 if slot == selected_slot else slot)

## Wraps around. From "nothing selected", +1 goes to slot 0 and -1 goes to the last slot.
func cycle_selection(step: int) -> void:
	if selected_slot == -1:
		select_slot(0 if step > 0 else MAX_SLOTS - 1)
	else:
		select_slot(posmod(selected_slot + step, MAX_SLOTS))

## The mouse is captured while playing, so the UI can't be clicked.
## Number keys 1-9 and 0 pick slots 1-10; the mouse wheel cycles.
func _unhandled_input(event: InputEvent) -> void:
	if not GameState.is_playing():
		return
	if event.is_action_pressed("inventory"):
		set_ui_open(not is_ui_open)
		return
	if event.is_action_pressed("use_item"):
		var held := get_selected_item()
		if held != null and held.use_action != &"":
			item_used.emit(held, selected_slot)
		return
	if event is InputEventKey and event.pressed and not event.echo:
		var keycode: int = event.physical_keycode
		if keycode >= KEY_1 and keycode <= KEY_9:
			toggle_slot(keycode - KEY_1)
		elif keycode == KEY_0:
			toggle_slot(9)
	elif event is InputEventMouseButton and event.pressed:
		if event.button_index == MOUSE_BUTTON_WHEEL_UP:
			cycle_selection(-1)
		elif event.button_index == MOUSE_BUTTON_WHEEL_DOWN:
			cycle_selection(1)

func set_ui_open(value: bool) -> void:
	if value == is_ui_open:
		return
	is_ui_open = value
	ui_toggled.emit(value)
</file>

<file path="src/player/player_gaze_caster.gd">
class_name PlayerGazeCaster
extends Camera3D

@export var max_gaze_distance: float = 20.0
@export var gaze_half_angle_deg: float = 12.0
@export var watchable_group: String = "gaze_watchable"

func _physics_process(delta: float) -> void:
	var looked_at := _find_gazed_target()

	for target in get_tree().get_nodes_in_group(watchable_group):
		GazeSystem.report(target, target == looked_at, delta)

func _find_gazed_target() -> Node3D:
	var camera_position: Vector3 = global_position
	var camera_forward: Vector3 = -global_transform.basis.z

	var best_target: Node3D = null
	var best_angle: float = gaze_half_angle_deg

	for target in get_tree().get_nodes_in_group(watchable_group):
		var target_node: Node3D = target as Node3D

		if target_node == null:
			continue

		var target_position: Vector3 = target_node.global_position
		target_position.y += 1.5

		var to_target: Vector3 = target_position - camera_position
		var distance: float = to_target.length()

		if distance <= 0.001 or distance > max_gaze_distance:
			continue

		var angle: float = rad_to_deg(
			camera_forward.angle_to(to_target.normalized())
		)

		if angle > best_angle:
			continue

		if not _can_hit_target(target_node):
			continue

		best_angle = angle
		best_target = target_node

	return best_target

func _can_hit_target(target: Node3D) -> bool:
	var space_state := get_world_3d().direct_space_state

	var query := PhysicsRayQueryParameters3D.create(
		global_position,
		global_position + (-global_transform.basis.z) * max_gaze_distance
	)

	var player := get_parent()
	query.exclude = [player]

	var result := space_state.intersect_ray(query)

	if result.is_empty():
		return false

	var collider: Node = result.collider as Node

	if collider == null:
		return false

	return _belongs_to_target(collider, target)

func _belongs_to_target(collider: Node, target: Node3D) -> bool:
	var current: Node = collider

	while current != null:
		if current == target:
			return true

		current = current.get_parent()

	return false
</file>

<file path="src/world/door.gd">
## Swinging door. The node's origin is the hinge, so place it at the hinge edge.
## Leave required_item_id empty for a door that is never locked.
class_name Door
extends Interactable

signal unlocked
signal opened
signal closed

@export var required_item_id: StringName = &""
@export var consume_item: bool = true
@export var open_angle_deg: float = 90.0
@export var open_time: float = 0.6
@export var locked_message: String = "It's locked."
@export var open_loudness: float = 0.5
# Noise when fail to open
@export var locked_loudness: float = 0.4

var is_locked: bool = false
var is_open: bool = false

var _closed_y: float = 0.0
var _tween: Tween

func _ready() -> void:
	is_locked = required_item_id != &""
	_closed_y = rotation.y
	add_to_group("saveable")

func get_prompt(interactor: Interactor) -> String:
	if not enabled:
		return ""
	if is_open:
		return "Close"
	if not is_locked:
		return "Open"
	var held := interactor.inventory.get_selected_item()
	if held != null and held.id == required_item_id:
		return "Unlock with %s" % held.display_name
	return "Locked"

func _on_interact(interactor: Interactor) -> void:
	if is_locked and not _try_unlock(interactor):
		_emit_noise(interactor, &"door_locked", locked_loudness)
		return
	_set_open(not is_open)
	_emit_noise(interactor, &"door_open" if is_open else &"door_close", open_loudness)

func _emit_noise(interactor: Interactor, noise_type: StringName, loudness: float) -> void:
	var tracker := LocationTracker.find_on(interactor.get_parent())
	NoiseManager.emit_noise(
		noise_type,
		loudness,
		tracker.room_id if tracker else &"",
		tracker.floor_id if tracker else 0,
		global_position
	)

func _try_unlock(interactor: Interactor) -> bool:
	var inventory := interactor.inventory
	var held := inventory.get_selected_item()
	if held == null:
		interactor.show_feedback(locked_message)
		return false
	if held.id != required_item_id:
		interactor.show_feedback("The %s doesn't fit." % held.display_name)
		return false
	if consume_item:
		inventory.remove_item(inventory.selected_slot)
	is_locked = false
	unlocked.emit()
	return true

func _set_open(value: bool) -> void:
	is_open = value
	if _tween:
		_tween.kill()
	var target := _closed_y
	if is_open:
		target += deg_to_rad(open_angle_deg)
	_tween = create_tween()
	_tween.tween_property(self, "rotation:y", target, open_time)
	if is_open:
		opened.emit()
	else:
		closed.emit()

func capture_state() -> Dictionary:
	return {"locked": is_locked, "open": is_open}

func restore_state(state: Dictionary) -> void:
	is_locked = state.get("locked", is_locked)
	is_open = state.get("open", is_open)
	if _tween:
		_tween.kill()
	rotation.y = _closed_y + (deg_to_rad(open_angle_deg) if is_open else 0.0)
</file>

<file path="src/entity/states/chase_state.gd">
class_name ChaseState
extends AIState

@export var base_speed: float = 5.0
@export var watched_speed_multiplier: float = 1.6
@export var give_up_time: float = 2.0
@export var turn_speed: float = 6.0

var _is_watched: bool = false
var _can_see_player: bool = true
var _give_up_timer: float = 0.0

func enter() -> void:
	_is_watched = false
	_can_see_player = true
	_give_up_timer = 0.0
	# Covers entering Chase without having seen the player (e.g. a scripted scare).
	entity.last_known_player_position = entity.perception.player.global_position

func physics_update(delta: float) -> void:
	var speed := base_speed * (watched_speed_multiplier if _is_watched else 1.0)
	# Only homes in on the player while it can see them; otherwise it goes
	# to the last spot it saw them, so breaking line of sight or hiding works.
	var target := (
		entity.perception.player.global_position if _can_see_player
		else entity.last_known_player_position
	)
	entity.move_towards(target, speed)
	if _can_see_player:
		entity.face_towards(target, turn_speed, delta)
	else:
		entity.face_movement(turn_speed, delta)

func on_gaze_changed(is_watched: bool, _watched_duration: float, _delta: float) -> void:
	_is_watched = is_watched

func on_perception_updated(can_see_player: bool, delta: float) -> void:
	_can_see_player = can_see_player
	if can_see_player:
		_give_up_timer = 0.0
	else:
		_give_up_timer += delta
		if _give_up_timer >= give_up_time:
			transition_requested.emit("Search")
</file>

<file path="src/entity/states/search_state.gd">
class_name SearchState
extends AIState
# Walk to where player is last seen when chase is lost
# Goes to patrol or detect after
@export var move_speed: float = 3.5
@export var turn_speed: float = 5.0
@export var look_around_time: float = 4.0
# Radians per second while looking around (1.5 for 4s is almost a full turn).
@export var look_turn_speed: float = 1.5
# Search time failsafe
@export var max_search_time: float = 15.0
 
var _search_position: Vector3
var _arrived: bool = false
var _look_timer: float = 0.0
var _total_timer: float = 0.0
 
func enter() -> void:
	_arrived = false
	_look_timer = 0.0
	_total_timer = 0.0
	_search_position = entity.last_known_player_position
 
func physics_update(delta: float) -> void:
	if _search_position.distance_to(entity.last_known_player_position) > 0.5:
		_search_position = entity.last_known_player_position
		_arrived = false
		_look_timer = 0.0
		_total_timer = 0.0
 
	_total_timer += delta
	if _total_timer >= max_search_time:
		transition_requested.emit("Patrol")
		return
 
	if not _arrived:
		entity.move_towards(_search_position, move_speed)
		entity.face_movement(turn_speed, delta)
		if entity.nav_agent.is_navigation_finished():
			_arrived = true
		return
 
	entity.rotate_y(look_turn_speed * delta)
	_look_timer += delta
	if _look_timer >= look_around_time:
		transition_requested.emit("Patrol")
 
func on_perception_updated(can_see_player: bool, _delta: float) -> void:
	if can_see_player:
		transition_requested.emit("Detect")
 
func on_noise_alert(_room_id: StringName, _floor_id: int, _world_position: Vector3) -> void:
	entity.respond_to_noise()
</file>

<file path="src/player/interactor.gd">
## Child of Player. Every physics frame it casts a ray from the player's head,
## finds the Interactable being looked at, and reports it to the HUD.
class_name Interactor
extends Node

## The Interactable under the crosshair, or null.
signal focus_changed(target: Interactable)
## Text for the prompt. Empty string means hide the prompt.
signal prompt_changed(text: String)
## One-off messages like "It's locked." or "Inventory full."
signal feedback(text: String)

@export var camera: Camera3D
@export var inventory: Inventory
## How close the player must be to an Interactable's origin (flat distance, height ignored).
@export var reach: float = 2.5
## The ray is this much longer than reach, so colliders set back from an object's
## visible front (a locker's back wall is 1.2 m behind its front) can still be hit.
## The reach check uses the Interactable's origin, not the hit point.
@export var ray_extra: float = 1.5
## After the ray stops hitting a target, keep it focused this many seconds.
## Stops one missed frame while walking from dropping the prompt or the E press.
@export var focus_grace_time: float = 0.15
@export var interact_action: StringName = &"interact"

var focused: Interactable
var _forced_focus: Interactable
var _prompt: String = ""
var _grace_left: float = 0.0

func _ready() -> void:
	if camera == null or inventory == null:
		push_warning("Interactor: assign 'camera' and 'inventory' in the inspector.")
	GameState.state_changed.connect(_on_game_state_changed)

func _physics_process(delta: float) -> void:
	if camera == null or not GameState.is_playing():
		return
	var target: Interactable = null
	if is_instance_valid(_forced_focus):
		target = _forced_focus
	else:
		target = _find_target()
		if target != null:
			_grace_left = focus_grace_time
		elif is_instance_valid(focused) and _grace_left > 0.0:
			_grace_left -= delta
			target = focused
	_set_focus(target)
	_set_prompt(focused.get_prompt(self) if is_instance_valid(focused) else "")

func _unhandled_input(event: InputEvent) -> void:
	if not event.is_action_pressed(interact_action):
		return
	if not GameState.is_playing() or not is_instance_valid(focused):
		return
	focused.interact(self)

func show_feedback(text: String) -> void:
	feedback.emit(text)

func force_focus(target: Interactable) -> void:
	_forced_focus = target

func release_focus() -> void:
	_forced_focus = null
	_grace_left = 0.0

func _find_target() -> Interactable:
	# The camera bobs while walking; its parent (Head) does not.
	var head := camera.get_parent() as Node3D
	var from: Vector3 = (head if head != null else camera).global_position
	var to := from + (-camera.global_transform.basis.z) * (reach + ray_extra)
	var query := PhysicsRayQueryParameters3D.create(from, to)
	query.exclude = [get_parent()]
	var hit := camera.get_world_3d().direct_space_state.intersect_ray(query)
	if hit.is_empty():
		return null
	var node := hit.collider as Node
	while node != null:
		if node is Interactable:
			var found := node as Interactable
			return found if _in_reach(found, from) else null
		node = node.get_parent()
	return null

func _in_reach(target: Interactable, from: Vector3) -> bool:
	var offset := target.global_position - from
	return Vector2(offset.x, offset.z).length() <= reach

func _set_focus(target: Interactable) -> void:
	if target == focused:
		return
	focused = target
	focus_changed.emit(focused)

func _set_prompt(text: String) -> void:
	if text == _prompt:
		return
	_prompt = text
	prompt_changed.emit(_prompt)

func _on_game_state_changed(_previous: GameState.State, new_state: GameState.State) -> void:
	if new_state != GameState.State.PLAYING:
		_grace_left = 0.0
		_set_focus(null)
		_set_prompt("")
</file>

<file path="src/entity/states/patrol_state.gd">
class_name PatrolState
extends AIState

@export var route: PatrolRoute
@export var move_speed: float = 2.0
@export var turn_speed: float = 4.0
@export var look_turn_speed: float = 1.0
@export var min_rooms_per_floor: int = 3
# Chance (0-1) of leaving for an adjacent floor once min_rooms_per_floor is met.
@export_range(0.0, 1.0) var floor_change_chance: float = 0.3
# The last N visited rooms are skipped when picking the next one.
@export var recent_memory: int = 2

var _has_target: bool = false
var _target_point: Vector3
var _target_look_time: float = 0.0
var _look_left: float = 0.0
var _flinching: bool = false
var _recent_rooms: Array[StringName] = []
var _rooms_on_floor: int = 0
var _last_floor: int = 0

# Fallback route state.
var _waypoints: Array[Vector3] = []
var _waypoint_index: int = 0

func enter() -> void:
	_flinching = false
	_has_target = false
	_look_left = 0.0
	if route != null:
		_waypoints = route.get_points()
	else:
		_waypoints = []
	_waypoint_index = clampi(_waypoint_index, 0, maxi(_waypoints.size() - 1, 0))

func physics_update(delta: float) -> void:
	if _flinching:
		# Stand and turn to player when staring
		entity.face_towards(entity.perception.player.global_position, turn_speed, delta)
		return

	if _look_left > 0.0:
		_look_left -= delta
		entity.rotate_y(look_turn_speed * delta)
		return

	if not _has_target:
		_choose_target()
		if not _has_target:
			_follow_route()
			return

	entity.move_towards(_target_point, move_speed)
	entity.face_movement(turn_speed, delta)
	if entity.nav_agent.is_navigation_finished():
		_has_target = false
		_look_left = _target_look_time

func on_gaze_changed(is_watched: bool, _watched_duration: float, _delta: float) -> void:
	_flinching = is_watched

func on_perception_updated(can_see_player: bool, _delta: float) -> void:
	if can_see_player:
		transition_requested.emit("Detect")

func on_noise_alert(_room_id: StringName, _floor_id: int, _world_position: Vector3) -> void:
	entity.respond_to_noise()

func _choose_target() -> void:
	_has_target = false
	var current_floor := entity.location.floor_id
	if current_floor != _last_floor:
		_last_floor = current_floor
		_rooms_on_floor = 0

	var target_floor := current_floor
	if _rooms_on_floor >= min_rooms_per_floor and randf() < floor_change_chance:
		target_floor = _pick_adjacent_floor(current_floor)

	var zone := _pick_zone(target_floor)
	if zone == null:
		return

	var points := zone.get_patrol_points()
	if points.is_empty():
		_target_point = zone.global_position
	else:
		_target_point = points[randi() % points.size()]
	_target_look_time = zone.look_around_time
	_has_target = true
	_rooms_on_floor += 1

	_recent_rooms.append(zone.room_id)
	while _recent_rooms.size() > recent_memory:
		_recent_rooms.pop_front()

func _pick_zone(floor_id: int) -> RoomZone:
	var zones: Array[RoomZone] = []
	for node in get_tree().get_nodes_in_group("room_zones"):
		var zone := node as RoomZone
		if zone != null and zone.floor_id == floor_id and zone.patrol_weight > 0.0:
			zones.append(zone)
	if zones.is_empty():
		return null

	# Skip recently visited rooms unless no other choices
	var pool: Array[RoomZone] = []
	for zone in zones:
		if not _recent_rooms.has(zone.room_id):
			pool.append(zone)
	if pool.is_empty():
		pool = zones

	var total := 0.0
	for zone in pool:
		total += zone.patrol_weight
	var roll := randf() * total
	for zone in pool:
		roll -= zone.patrol_weight
		if roll <= 0.0:
			return zone
	return pool.back()

func _pick_adjacent_floor(current_floor: int) -> int:
	var floors: Array[int] = []
	for node in get_tree().get_nodes_in_group("room_zones"):
		var zone := node as RoomZone
		if zone != null and absi(zone.floor_id - current_floor) == 1 and not floors.has(zone.floor_id):
			floors.append(zone.floor_id)
	if floors.is_empty():
		return current_floor
	return floors[randi() % floors.size()]

func _follow_route() -> void:
	if _waypoints.is_empty():
		return
	entity.move_towards(_waypoints[_waypoint_index], move_speed)
	entity.face_movement(turn_speed, get_physics_process_delta_time())
	if entity.nav_agent.is_navigation_finished():
		_waypoint_index = (_waypoint_index + 1) % _waypoints.size()
</file>

<file path="src/player/player.gd">
class_name Player
extends CharacterBody3D

@export var move_speed: float = 4.0
@export var sprint_speed: float = 7.0
@export var mouse_sensitivity: float = 0.003
@export var min_pitch_deg: float = -80.0
@export var max_pitch_deg: float = 80.0

@export var step_height: float = 0.6
@export var step_check_distance: float = 0.6
## Distance from the player's origin down to the bottom of the capsule.
## Capsule is centered at y=0.1 with height 1.8, so the bottom is at -0.8.
@export var feet_offset: float = 0.8
@onready var head: Node3D = $Head
@onready var hide_component: Node = $Hide   # Concealment.gd — exposes `is_hidden`

@export var bob_walk_frequency: float = 10.0
@export var bob_sprint_frequency: float = 15.0
@export var bob_walk_amplitude: float = 0.04
@export var bob_sprint_amplitude: float = 0.08
@export var bob_return_speed: float = 8.0
@onready var camera: Camera3D = $Head/Camera3D
var _bob_time: float = 0.0
var _camera_rest_position: Vector3
var _gravity: float = ProjectSettings.get_setting("physics/3d/default_gravity")
# True while hiding in a Locker: no walking, and the view is limited.
var controls_locked: bool = false
var _look_limited: bool = false
var _yaw_center: float = 0.0
var _yaw_half_range: float = 0.0
var _pitch_half_range: float = 0.0
# Used in locker tween
var _look_frozen: bool = false

func _ready() -> void:
	add_to_group("player")
	add_to_group("saveable")
	Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
	_camera_rest_position = camera.position

func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventMouseMotion and Input.mouse_mode == Input.MOUSE_MODE_CAPTURED and not _look_frozen:
		rotate_y(-event.relative.x * mouse_sensitivity)
		head.rotate_x(-event.relative.y * mouse_sensitivity)
		var pitch_min := deg_to_rad(min_pitch_deg)
		var pitch_max := deg_to_rad(max_pitch_deg)
		if _look_limited:
			rotation.y = _yaw_center + clampf(
				angle_difference(_yaw_center, rotation.y), -_yaw_half_range, _yaw_half_range
			)
			pitch_min = -_pitch_half_range
			pitch_max = _pitch_half_range
		head.rotation.x = clamp(head.rotation.x, pitch_min, pitch_max)

func _update_head_bob(delta: float, sprinting: bool) -> void:
	var horizontal_speed := Vector2(velocity.x, velocity.z).length()

	if is_on_floor() and horizontal_speed > 0.5:
		var frequency := bob_sprint_frequency if sprinting else bob_walk_frequency
		var amplitude := bob_sprint_amplitude if sprinting else bob_walk_amplitude
		_bob_time += delta * frequency
		# Up and down once per step, side to side once per two steps.
		camera.position.y = _camera_rest_position.y + sin(_bob_time) * amplitude
		camera.position.x = _camera_rest_position.x + cos(_bob_time * 0.5) * amplitude * 0.5
	else:
		# Standing still, in the air, or pushing against a wall: ease back to rest.
		_bob_time = 0.0
		camera.position = camera.position.lerp(
			_camera_rest_position, clamp(bob_return_speed * delta, 0.0, 1.0)
		)

func _physics_process(delta: float) -> void:
	if controls_locked:
		velocity = Vector3.ZERO
		return

	if not is_on_floor():
		velocity.y -= _gravity * delta

	var sprinting := Input.is_action_pressed("sprint")
	var current_speed := sprint_speed if sprinting else move_speed
	var input_dir := Input.get_vector("move_left", "move_right", "move_forward", "move_back")
	var direction := (transform.basis * Vector3(input_dir.x, 0.0, input_dir.y)).normalized()

	if direction:
		velocity.x = direction.x * current_speed
		velocity.z = direction.z * current_speed
	else:
		velocity.x = move_toward(velocity.x, 0.0, current_speed)
		velocity.z = move_toward(velocity.z, 0.0, current_speed)

	move_and_slide()
	_update_head_bob(delta, sprinting)

func is_hidden() -> bool:
	return hide_component.is_hidden

func lock_controls(yaw_center: float, yaw_half_range_deg: float, pitch_half_range_deg: float) -> void:
	controls_locked = true
	velocity = Vector3.ZERO
	_look_limited = true
	_yaw_center = yaw_center
	_yaw_half_range = deg_to_rad(yaw_half_range_deg)
	_pitch_half_range = deg_to_rad(pitch_half_range_deg)
	rotation.y = yaw_center
	head.rotation.x = 0.0
	camera.position = _camera_rest_position
	_look_frozen = false

func unlock_controls() -> void:
	controls_locked = false
	_look_limited = false
	_look_frozen = false

func freeze_controls() -> void:
	controls_locked = true
	velocity = Vector3.ZERO
	_look_frozen = true

func capture_state() -> Dictionary:
	return {
		"position": global_position,
		"yaw": rotation.y,
		"pitch": head.rotation.x,
	}

func restore_state(state: Dictionary) -> void:
	unlock_controls()
	velocity = Vector3.ZERO
	global_position = state.get("position", global_position)
	rotation.y = state.get("yaw", rotation.y)
	head.rotation.x = state.get("pitch", 0.0)

func get_save_summary() -> Dictionary:
	var tracker := LocationTracker.find_on(self)
	if tracker == null:
		return {}
	return {"room_id": tracker.room_id, "floor_id": tracker.floor_id}
</file>

<file path="src/entity/ai_entity.gd">
class_name AIEntity
extends CharacterBody3D

signal woke
signal slept
signal detect_started
signal detect_ended
signal chase_started
signal chase_ended
signal caught_player 

@export var starts_dormant: bool = false

@export var perception: EntityPerception
@export var state_machine: AIStateMachine
@export var nav_agent: NavigationAgent3D

## How close (flat, height ignored) the entity must get to a point on the red line
## before it turns toward the next one. Smaller = takes corners tighter.
@export var path_reach: float = 0.2
@export var repath_interval: float = 0.4

var location: LocationTracker
var hearing: EntityHearing

# Where the entity believes the player is, from sight or noise.
# Updated every frame the entity can see the player. Used by Chase and Search.
var last_known_player_position: Vector3

var noise_room_id: StringName = &""
var noise_floor_id: int = 0
var noise_position: Vector3

var _gravity: float = ProjectSettings.get_setting("physics/3d/default_gravity")
var _path: PackedVector3Array = PackedVector3Array()
var _path_index: int = 0
var _path_target: Vector3 = Vector3.INF
var _repath_left: float = 0.0
var _move_direction: Vector3 = Vector3.ZERO

var is_active: bool = true
var _default_process_mode: Node.ProcessMode = Node.PROCESS_MODE_INHERIT

func _ready() -> void:
	_default_process_mode = process_mode
	add_to_group("gaze_watchable")
	floor_snap_length = 0.5
	for child in get_children():
		if child is LocationTracker:
			location = child as LocationTracker
		elif child is EntityHearing:
			hearing = child as EntityHearing
	if location == null:
		push_warning("AIEntity: add a LocationTracker child.")
	if hearing:
		hearing.noise_alert.connect(_on_noise_alert)
	if state_machine:
		state_machine.state_changed.connect(_on_state_changed)
	if starts_dormant:
		sleep()

## Invisible, no physics body, no AI. Also usable mid-game.
func sleep() -> void:
	if not is_active:
		return
	is_active = false
	visible = false
	velocity = Vector3.ZERO
	_path = PackedVector3Array()
	process_mode = Node.PROCESS_MODE_DISABLED
	slept.emit()

## Starts the entity from wherever it is placed in Patrol.
func wake() -> void:
	if is_active:
		return
	is_active = true
	visible = true
	process_mode = _default_process_mode
	state_machine.force_transition("Patrol")
	woke.emit()

func _physics_process(delta: float) -> void:
	var sees_player := perception.can_see_player()
	if sees_player:
		last_known_player_position = perception.player.global_position
	state_machine.notify_perception(sees_player, delta)
	state_machine.notify_gaze(
		GazeSystem.is_watched(self),
		GazeSystem.get_watched_duration(self),
		delta
	)

# Called by the states that respond to noise
func respond_to_noise() -> void:
	if noise_floor_id != location.floor_id:
		state_machine.force_transition("Investigate")
	else:
		last_known_player_position = noise_position
		state_machine.force_transition("Search")

func _on_noise_alert(room_id: StringName, floor_id: int, world_position: Vector3) -> void:
	noise_room_id = room_id
	noise_floor_id = floor_id
	noise_position = world_position
	state_machine.notify_noise(room_id, floor_id, world_position)

func move_towards(target_position: Vector3, speed: float) -> void:
	var delta := get_physics_process_delta_time()

	# Kept as before: the states still ask nav_agent.is_navigation_finished().
	nav_agent.target_position = target_position

	# Recalculate the path when the target moved, or every repath_interval seconds.
	_repath_left -= delta
	if _path.is_empty() or _repath_left <= 0.0 or _path_target.distance_to(target_position) > 0.5:
		_path = NavigationServer3D.map_get_path(
			nav_agent.get_navigation_map(), global_position, target_position, true
		)
		_path_index = 0
		_path_target = target_position
		_repath_left = repath_interval

	var horizontal := Vector3.ZERO
	if not _path.is_empty():
		# Never smaller than one frame of travel, so a fast entity can't jump past a point.
		var reach := maxf(path_reach, speed * delta * 1.5)
		while _path_index < _path.size() - 1 and _flat_distance_to(_path[_path_index]) < reach:
			_path_index += 1
		var to_point := _path[_path_index] - global_position
		to_point.y = 0.0
		if to_point.length() > 0.05:
			horizontal = to_point.normalized() * speed
	_move_direction = horizontal.normalized()
	velocity.x = horizontal.x
	velocity.z = horizontal.z
	if is_on_floor():
		velocity.y = 0.0
	else:
		velocity.y -= _gravity * delta
	move_and_slide()

func _flat_distance_to(point: Vector3) -> float:
	return Vector2(point.x - global_position.x, point.z - global_position.z).length()

func face_towards(target_position: Vector3, turn_speed: float, delta: float) -> void:
	var flat_target := target_position
	flat_target.y = global_position.y
	if global_position.distance_to(flat_target) < 0.01:
		return
	var current := global_transform.basis.get_rotation_quaternion()
	var wanted := global_transform.looking_at(flat_target, Vector3.UP).basis.get_rotation_quaternion()
	var turned := current.slerp(wanted, clamp(turn_speed * delta, 0.0, 1.0))
	global_transform.basis = Basis(turned)

## Turns toward the direction the body is actually walking (the next stretch of the path).
func face_movement(turn_speed: float, delta: float) -> void:
	if _move_direction == Vector3.ZERO:
		return
	face_towards(global_position + _move_direction, turn_speed, delta)

func capture_state() -> Dictionary:
	return {
		"position": global_position,
		"yaw": rotation.y,
		"state": state_machine.current_state_name,
		"last_known": last_known_player_position,
		"is_active": is_active,
	}

func restore_state(state: Dictionary) -> void:
	velocity = Vector3.ZERO
	_path = PackedVector3Array()
	global_position = state.get("position", global_position)
	rotation.y = state.get("yaw", rotation.y)
	is_active = state.get("is_active", true)
	state_machine.force_transition(state.get("state", "Patrol"))
	last_known_player_position = state.get("last_known", last_known_player_position)

func _on_state_changed(previous: String, new_state: String) -> void:
	if previous == "Detect":
		detect_ended.emit()
	if previous == "Chase":
		chase_ended.emit()
	if new_state == "Detect":
		detect_started.emit()
	elif new_state == "Chase":
		chase_started.emit()
